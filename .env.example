# CraftCord Discord Bot configuration
# Copy this file to `.env` and fill in the values.
# Product: CraftCord (craftcordbot.com) — Your server. Your Discord. Connected.
# Each instance connects one Discord guild to one Minecraft server.
# ──────────────────────────────────────────────────────────────────

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# REQUIRED. Discord guild (server) ID this installation is bound to.
# Commands, chat bridge, and outbound channels are refused outside this
# guild. Missing, blank, zero, or negative values prevent startup.
DISCORD_GUILD_ID=

# ── Role IDs for permissions (right-click role -> Copy ID) ────────
ADMIN_ROLE_ID=
MOD_ROLE_ID=
MEMBER_ROLE_ID=

# ── Channel IDs ──────────────────────────────────────────────────
# All channel IDs must belong to DISCORD_GUILD_ID. Channels from other
# guilds are rejected even if Discord can resolve the ID.
#
# Channel where the auto-updating server-status embed lives.
STATUS_CHANNEL_ID=
# Channel for generic Minecraft console output (code blocks).
# Only used when ENABLE_CONSOLE_MIRROR=true. Raw console lines can
# contain player IP addresses, UUIDs, chat, and operational detail —
# restrict this channel to trusted staff. Filtering does not make raw
# logs safe for public channels.
CONSOLE_CHANNEL_ID=
# Set to true to mirror unclassified console lines to CONSOLE_CHANNEL_ID.
# Defaults to false. Chat and event routing still work when their
# dedicated channels are set and this is false. A log line containing
# [STAFF_ALERT] is not special; it is ordinary console text only when
# mirroring is enabled.
ENABLE_CONSOLE_MIRROR=false
# Bidirectional chat bridge:
#   - Player chat (<Alice> hi)   -> forwarded here as "**[Minecraft]** **Alice**: hi"
#   - Messages typed here        -> sent in-game via RCON /tellraw (role-gated)
# Requires the MESSAGE CONTENT intent (Developer Portal -> Bot ->
# Privileged Gateway Intents -> Message Content Intent).
# Discord -> MC relay requires configured-guild owner, Discord
# Administrator, or a configured admin/mod/member role; others are
# silently ignored. Leave blank to disable (Message Content not required).
CHAT_CHANNEL_ID=
# Pretty embeds for join / leave / death / advancement events.
# Leave blank to drop those events (they do not fall through to console).
EVENTS_CHANNEL_ID=

# ── Sender identity (optional) ───────────────────────────────────
# bot    (default) — CraftCord's name/avatar, exactly as before.
# player — post as "PlayerName • Minecraft" with the player's skin head
#          through one CraftCord-owned webhook per channel. Chat body is
#          just the message text; events keep their existing embeds.
# Each accepts only `bot` or `player` and is chosen independently.
# Player mode needs the Manage Webhooks permission in that channel; if
# setup or delivery definitely fails, the message is posted in the old
# CraftCord format in the same channel. Slash-command replies, the
# pinned status, and console output always stay CraftCord.
# Player mode sends the Minecraft username to api.minecraftservices.com
# and places the resulting UUID in a crafatar.com image URL. See README.
# Example enabling both:
#   CHAT_IDENTITY_MODE=player
#   EVENTS_IDENTITY_MODE=player
CHAT_IDENTITY_MODE=bot
EVENTS_IDENTITY_MODE=bot

# ── Minecraft server connection ──────────────────────────────────
# One Minecraft Java server per CraftCord instance.
MC_HOST=
MC_PORT=
# Pretty address shown in the /status embed. Purely cosmetic — the bot
# still pings MC_HOST:MC_PORT. Leave blank to omit the Address field
# entirely (backend host/port are never shown).
# Example: play.example.com
PUBLIC_ADDRESS=

# RCON (enable-rcon=true in server.properties)
RCON_HOST=
RCON_PORT=
RCON_PASSWORD=

# ── Log ingestion ────────────────────────────────────────────────
# How the bot reads the Minecraft server's console output.
#   local       — tail latest.log on the local filesystem (bot must
#                 run on the same machine as the MC server).
#   pterodactyl — connect to a Pterodactyl panel's WebSocket API
#                 (PebbleHost, BisectHosting, Apex, Shockbyte, …).
LOG_SOURCE=local

# LOG_SOURCE=local: absolute path to latest.log.
# On PebbleHost this is usually: /home/container/logs/latest.log
MC_LOG_PATH=

# LOG_SOURCE=pterodactyl: panel base URL (no trailing slash).
# For PebbleHost this is https://panel.pebblehost.com.
PTERODACTYL_PANEL_URL=
# The short server identifier shown in the panel URL when you open
# your server (e.g. "abcd1234" from https://panel.../server/abcd1234).
PTERODACTYL_SERVER_ID=
# A Client API key generated from the panel's
# Account -> API Credentials page. Keep this secret.
# Invalid credentials log an error once and disable mirroring until
# the bot is restarted or credentials are fixed.
PTERODACTYL_API_KEY=

# ── Behaviour tweaks (optional) ──────────────────────────────────
# How often (seconds) to refresh the status embed (minimum 10).
STATUS_UPDATE_INTERVAL=30
# SQLite database file. Stores the pinned status message id and
# reachability-based online_since timestamp only.
DATABASE_PATH=data/bot.db
